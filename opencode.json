{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "tester": {
      "description": "Runs the full semba-fdtd test suite (unit + integration tests), builds if needed, and produces a JSON report + terminal summary",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "deny",
        "external_directory": "allow"
      }
    }
  }
}
