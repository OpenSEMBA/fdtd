{
  "version": 3,
  "configurePresets": [
    {
      "name": "rls",
      "generator": "Ninja",
      "binaryDir": "build-rls/",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SEMBA_FDTD_ENABLE_MPI": "OFF"
      }
    },
    {
      "name": "dbg",
      "inherits": "rls",
      "binaryDir": "build-dbg/",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "rls-mpi",
      "inherits": "rls",
      "binaryDir": "build-rls-mpi/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "dbg-mpi",
      "inherits": "dbg",
      "binaryDir": "build-dbg-mpi/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_MPI": "ON"
      }
    },
    {
      "name": "dbg-nomtln",
      "inherits": "dbg",
      "binaryDir": "build-dbg-nomtln/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_MTLN": "OFF"
      }
    },
    {
      "name": "rls-nomtln",
      "inherits": "rls",
      "binaryDir": "build-rls-nomtln/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_MTLN": "OFF"
      }
    },
    {
      "name": "intel-rls",
      "generator": "Ninja",
      "binaryDir": "build-intel-rls/",
      "environment": {
        "I_MPI_ROOT": "/opt/intel/oneapi/mpi/latest",
        "FC": "mpiifx",
        "CC": "mpiicx",
        "CXX": "mpiicpx"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SEMBA_FDTD_ENABLE_MPI": "ON",
        "SEMBA_FDTD_ENABLE_MTLN": "ON",
        "SEMBA_FDTD_ENABLE_DOUBLE_PRECISION": "ON"
      }
    },
    {
      "name": "intel-rls-nomtln",
      "inherits": "intel-rls",
      "binaryDir": "build-intel-rls-nomtln/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_MTLN": "OFF"
      }
    },
    {
      "name": "intel-dbg",
      "inherits": "intel-rls",
      "binaryDir": "build-intel-dbg/",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wsl-rls-r4",
      "generator": "Ninja",
      "binaryDir": "build-wsl-rls-r4/",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "environment": {
        "FC": "gfortran",
        "CC": "gcc",
        "CXX": "g++"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SEMBA_FDTD_ENABLE_MPI": "OFF",
        "SEMBA_FDTD_ENABLE_DOUBLE_PRECISION": "OFF"
      }
    },
    {
      "name": "wsl-rls-r8",
      "inherits": "wsl-rls-r4",
      "binaryDir": "build-wsl-rls-r8/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_DOUBLE_PRECISION": "ON"
      }
    },
    {
      "name": "win-rls-r4",
      "inherits": "rls",
      "binaryDir": "build-win-rls-r4/",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_DOUBLE_PRECISION": "OFF"
      }
    },
    {
      "name": "win-rls-r8",
      "inherits": "win-rls-r4",
      "binaryDir": "build-win-rls-r8/",
      "cacheVariables": {
        "SEMBA_FDTD_ENABLE_DOUBLE_PRECISION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rls",
      "configurePreset": "rls"
    },
    {
      "name": "dbg",
      "configurePreset": "dbg"
    },
    {
      "name": "rls-mpi",
      "configurePreset": "rls-mpi"
    },
    {
      "name": "dbg-mpi",
      "configurePreset": "dbg-mpi"
    },
    {
      "name": "rls-nomtln",
      "configurePreset": "rls-nomtln"
    },
    {
      "name": "dbg-nomtln",
      "configurePreset": "dbg-nomtln"
    },
    {
      "name": "intel-rls",
      "configurePreset": "intel-rls"
    },
    {
      "name": "intel-rls-nomtln",
      "configurePreset": "intel-rls-nomtln"
    },
    {
      "name": "intel-dbg",
      "configurePreset": "intel-dbg"
    },
    {
      "name": "wsl-rls-r4",
      "configurePreset": "wsl-rls-r4"
    },
    {
      "name": "wsl-rls-r8",
      "configurePreset": "wsl-rls-r8"
    },
    {
      "name": "win-rls-r4",
      "configurePreset": "win-rls-r4"
    },
    {
      "name": "win-rls-r8",
      "configurePreset": "win-rls-r8"
    }
  ]
}
