module version_m
    character(*), parameter :: PROGRAM_NAME="@PROGRAM_NAME@"
    character(*), parameter :: COMPILATION_DATE= __DATE__ // " " // __TIME__  
    character(*), parameter :: GIT_COMMIT="@GIT_COMMIT@"
    character(*), parameter :: COMPILER_ID="@CMAKE_Fortran_COMPILER_ID@ @CMAKE_Fortran_COMPILER_VERSION@"
    character(*), parameter :: CMAKE_BUILD_TYPE="@CMAKE_BUILD_TYPE@"
    character(*), parameter :: COMPILATION_FLAGS="@CMAKE_Fortran_FLAGS@"
    character(*), parameter :: COMPILATION_FLAGS_DEBUG="@CMAKE_Fortran_FLAGS@ @CMAKE_Fortran_FLAGS_DEBUG@"
    character(*), parameter :: COMPILATION_FLAGS_RELEASE="@CMAKE_Fortran_FLAGS@ @CMAKE_Fortran_FLAGS_RELEASE@"
end module version_m
