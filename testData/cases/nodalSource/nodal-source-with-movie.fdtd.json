{
    "format": "FDTD Input file",
    "__comments": "Nodal-current pulse through a dielectric volume, with movie, point, and bulk-current probes.",

    "general": {
        "timeStep": 0.05e-9,
        "numberOfSteps": 400,
        "additionalArguments": "-mapvtk"
    },

    "boundary": {
        "all": {"type": "mur"}
    },

    "mesh": {
        "grid": {
            "numberOfCells": [30, 30, 10],
            "steps": {"x": [0.01], "y": [0.01], "z": [0.01]}
        },
        "coordinates": [
            {"id": 1, "relativePosition": [5, 15, 5]},
            {"id": 2, "relativePosition": [20, 15, 5]}
        ],
        "elements": [
            {"id": 1, "type": "cell", "name": "source-segment", "intervals": [[[2, 15, 5], [3, 15, 5]]]},
            {"id": 2, "type": "cell", "name": "movie-volume", "intervals": [[[0, 0, 0], [30, 30, 10]]]},
            {"id": 3, "type": "cell", "name": "slow-medium", "intervals": [[[2, 0, 0], [30, 30, 10]]]},
            {"id": 4, "type": "node", "name": "near-point", "coordinateIds": [1]},
            {"id": 5, "type": "node", "name": "far-point", "coordinateIds": [2]},
            {"id": 6, "type": "cell", "name": "bulk-current-plane", "intervals": [[[20, 0, 0], [20, 30, 10]]]}
        ]
    },

    "materials": [
        {
            "id": 1,
            "name": "slow-medium",
            "type": "isotropic",
            "relativePermittivity": 169
        }
    ],

    "materialAssociations": [
        {"materialId": 1, "elementIds": [3]}
    ],

    "sources": [
        {
            "name": "x_current_pulse",
            "type": "nodalSource",
            "magnitudeFile": "predefinedExcitation.1.exc",
            "elementIds": [1],
            "field": "current"
        }
    ],

    "probes": [
        {
            "name": "electric_field_movie",
            "type": "movie",
            "field": "electric",
            "component": "magnitude",
            "elementIds": [2],
            "domain": {
                "type": "time",
                "initialTime": 0.0,
                "finalTime": 5e-9,
                "samplingPeriod": 1.5e-12
            }
        },
        {
            "name": "electric_field_near_source",
            "type": "point",
            "field": "electric",
            "directions": ["x"],
            "elementIds": [4],
            "domain": {"type": "time"}
        },
        {
            "name": "electric_field_far_from_source",
            "type": "point",
            "field": "electric",
            "directions": ["x"],
            "elementIds": [5],
            "domain": {"type": "time"}
        },
        {
            "name": "bulk_current_far_from_source",
            "type": "bulkCurrent",
            "elementIds": [6],
            "domain": {"type": "time"}
        }
    ]
}
