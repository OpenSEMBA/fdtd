{
    "format": "FDTD Input file",
    "__comments": "Point probes in the three domains: time, frequency and timeFrequency.",

    "general": {
        "timeStep": 3e-11,
        "numberOfSteps": 1000
    },

    "boundary": {
        "all": {"type": "mur"}
    },

    "mesh": {
        "grid": {
            "numberOfCells": [30, 30, 30],
            "steps": { "x": [0.02], "y": [0.02], "z": [0.02] }
        },
        "coordinates": [
            {"id": 1, "relativePosition": [15, 15, 15]},
            {"id": 2, "relativePosition": [15, 15, 20]}
        ],
        "elements": [
            {"id": 1, "type": "node", "coordinateIds": [1]},
            {"id": 2, "type": "node", "coordinateIds": [2]},
            {"id": 10, "type": "cell", "intervals": [ [ [8, 8, 8], [23, 23, 23] ] ]}
        ]
    },

    "sources": [
        {
            "type": "planewave",
            "magnitudeFile": "gauss.exc",
            "elementIds": [10],
            "direction": { "theta": 0.0, "phi": 0.0 },
            "polarization": { "theta": 1.5708, "phi": 0.0 }
        }
    ],

    "probes": [
        {
            "name": "E_point_time",
            "type": "point",
            "field": "electric",
            "elementIds": [1],
            "directions": ["x", "y", "z"],
            "domain": { "type": "time" }
        },
        {
            "name": "H_point_time",
            "type": "point",
            "field": "magnetic",
            "elementIds": [1],
            "directions": ["y"],
            "domain": { "type": "time" }
        },
        {
            "name": "E_point_frequency",
            "type": "point",
            "field": "electric",
            "elementIds": [2],
            "directions": ["x"],
            "domain": {
                "type": "frequency",
                "initialFrequency": 5e7,
                "finalFrequency": 1e9,
                "numberOfFrequencies": 20
            }
        },
        {
            "name": "E_point_timeFrequency",
            "type": "point",
            "field": "electric",
            "elementIds": [2],
            "directions": ["x"],
            "domain": {
                "type": "timeFrequency",
                "initialFrequency": 5e7,
                "finalFrequency": 1e9,
                "numberOfFrequencies": 20
            }
        }
    ]
}
