{
    "format": "FDTD Input file",
    "__comments": "Movie probes over a small volume: one in time domain, one in frequency domain.",

    "general": {
        "timeStep": 3e-11,
        "numberOfSteps": 1000
    },

    "boundary": {
        "all": {"type": "mur"}
    },

    "mesh": {
        "grid": {
            "numberOfCells": [30, 30, 30],
            "steps": { "x": [0.02], "y": [0.02], "z": [0.02] }
        },
        "elements": [
            {"id": 10, "type": "cell", "intervals": [ [ [8, 8, 8], [23, 23, 23] ] ]},
            {"id": 11, "type": "cell", "intervals": [ [ [12, 12, 12], [18, 18, 18] ] ]}
        ]
    },

    "sources": [
        {
            "type": "planewave",
            "magnitudeFile": "gauss.exc",
            "elementIds": [10],
            "direction": { "theta": 0.0, "phi": 0.0 },
            "polarization": { "theta": 1.5708, "phi": 0.0 }
        }
    ],

    "probes": [
        {
            "name": "movie_electric_time",
            "type": "movie",
            "field": "electric",
            "component": "magnitude",
            "elementIds": [11],
            "domain": {
                "type": "time",
                "initialTime": 0.0,
                "finalTime": 3e-8,
                "samplingPeriod": 3e-10
            }
        },
        {
            "name": "movie_electric_frequency",
            "type": "movie",
            "field": "electric",
            "component": "x",
            "elementIds": [11],
            "domain": {
                "type": "frequency",
                "initialFrequency": 5e7,
                "finalFrequency": 1e9,
                "numberOfFrequencies": 5
            }
        }
    ]
}
